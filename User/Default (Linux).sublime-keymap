[
  { "keys": ["ctrl+alt+n"], "command": "advanced_new_file_new" },
  { "keys": ["super+alt+c", "super+alt+s"], "command": "convert_to_snake" },
  {
    "keys": ["super+alt+c", "super+alt+shift+s"],
    "command": "convert_to_screaming_snake"
  },
  { "keys": ["super+alt+c", "super+alt+c"], "command": "convert_to_camel" },
  { "keys": ["super+alt+c", "super+alt+p"], "command": "convert_to_pascal" },
  { "keys": ["super+alt+c", "super+alt+d"], "command": "convert_to_dot" },
  { "keys": ["super+alt+c", "super+alt+h"], "command": "convert_to_dash" },
  {
    "keys": ["super+alt+c", "super+alt+w"],
    "command": "convert_to_separate_words"
  },
  { "keys": ["super+alt+c", "super+alt+/"], "command": "convert_to_slash" },
  {
    "keys": ["super+alt+c", "super+alt+b"],
    "command": "convert_to_back_slash"
  },
  { "keys": ["super+shift+-"], "command": "toggle_snake_camel_pascal" },
  {
    "keys": ["super+alt+c", "super+alt+t"],
    "command": "chain",
    "args": {
      "commands": [["convert_to_separate_words"], ["title_case"]]
    }
  },
  { "keys": ["ctrl+shift+h"], "command": "js_prettier" },
  {
    "keys": ["ctrl+shift+k"],
    "command": "run_macro_file",
    "args": {
      "file": "res://Packages/Default/Delete Line.sublime-macro"
    }
  },
  {
    "keys": ["ctrl+h"],
    "command": "show_panel",
    "args": { "panel": "replace", "reverse": false }
  },
  {
    "keys": ["ctrl+shift+z"],
    "command": "set_setting",
    "args": {
      "setting": "tab_size",
      "value": 1
    }
  },
  {
    "keys": ["ctrl+shift+x"],
    "command": "set_setting",
    "args": {
      "setting": "tab_size",
      "value": 4
    }
  },
  {
    "keys": ["tab"],
    "command": "expand_abbreviation_by_tab",
    // Emmet
    // put comma-separated syntax selectors for which
    // you want to expandEmmet abbreviations into "operand" key
    // instead of SCOPE_SELECTOR.
    // Examples: source.js, text.html - source
    "context": [
      {
        "operand": "meta.group.braces.round.js, text.html",
        "operator": "equal",
        "match_all": true,
        "key": "selector"
      },

      // run only if there's no selected text
      {
        "match_all": true,
        "key": "selection_empty"
      },

      // don't work if there are active tabstops
      {
        "operator": "equal",
        "operand": false,
        "match_all": true,
        "key": "has_next_field"
      },

      // don't work if completion popup is visible and you
      // want to insert completion with Tab. If you want to
      // expand Emmet with Tab even if popup is visible --
      // remove this section
      {
        "operand": false,
        "operator": "equal",
        "match_all": true,
        "key": "auto_complete_visible"
      },
      {
        "match_all": true,
        "key": "is_abbreviation"
      }
    ]
  }
]
